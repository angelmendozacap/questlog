# Copy to .env.local for `pnpm dev` outside Docker.
# Requires Keycloak running, e.g.:
#   docker compose -f deploy/docker-compose.yml up -d keycloak

# Must differ from apps/web's AUTH_SECRET, and AUTH_COOKIE_NAME below must
# differ from apps/web's too — cookies aren't port-scoped, so
# localhost:3000 and localhost:3001 share one cookie jar, and Auth.js
# derives its session-encryption key from hkdf(secret, salt=cookieName).
# Matching both would let either app decrypt the other's session token as
# valid. Still an obvious dev placeholder, not a real secret.
AUTH_SECRET=dev-only-insecure-secret-change-me-admin
AUTH_KEYCLOAK_ID=questlog-admin
AUTH_KEYCLOAK_SECRET=questlog-admin-dev-secret
AUTH_KEYCLOAK_ISSUER=http://localhost:8082/realms/questlog
# AUTH_KEYCLOAK_INTERNAL_ISSUER=http://keycloak:8080/realms/questlog
AUTH_COOKIE_NAME=questlog-admin.session-token
# Keycloak keeps its own SSO session independently of this app's session
# cookie, so a plain sign-out + sign-in silently re-authenticates as
# whoever was last signed in — a dead end on the access-denied screen,
# where switching accounts is the whole point. This forces Keycloak to
# always show the login form instead.
AUTH_PROMPT_LOGIN=true

IDENTITY_SYNC_URL=http://localhost:8080/auth/sync
