{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "generate": {
      "inputs": ["../../api/openapi.yaml"],
      "outputs": ["src/generated/**"]
    },
    "build": {
      "dependsOn": ["^build", "generate"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"],
      // apps/web (and, from Task 11, apps/admin) transitively import
      // @questlog/auth's authConfig, which reads these at module-eval
      // time — and `next build` imports/executes that module while
      // collecting page data for the NextAuth route handler, even though
      // none of authConfig's callbacks run until a real request. Turborepo
      // defaults to strict env mode: without listing these, turbo strips
      // them from the child `next build` process even if they're set in
      // the invoking shell, so `pnpm turbo build` fails where a bare
      // `pnpm --filter web build` wouldn't. See deploy/Dockerfile.node for
      // the equivalent fix for containerized builds.
      "env": [
        "AUTH_SECRET",
        "AUTH_KEYCLOAK_ID",
        "AUTH_KEYCLOAK_SECRET",
        "AUTH_KEYCLOAK_ISSUER",
        "AUTH_KEYCLOAK_INTERNAL_ISSUER",
        "IDENTITY_SYNC_URL"
      ]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {
      "dependsOn": ["^build", "generate"]
    },
    "typecheck": {
      "dependsOn": ["^build", "generate"]
    }
  }
}
